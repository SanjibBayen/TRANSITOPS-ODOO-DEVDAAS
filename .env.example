# ============================================
# TRANSITOPS - ENVIRONMENT CONFIGURATION
# ============================================

# --------------------------------------------
# SUPABASE (Required)
# --------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# --------------------------------------------
# SERVER
# --------------------------------------------
PORT=5000
NODE_ENV=development

# --------------------------------------------
# FRONTEND
# --------------------------------------------
FRONTEND_URL=http://localhost:5173

# --------------------------------------------
# CLOUDINARY (Required - Document Storage)
# --------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --------------------------------------------
# RESEND (Required - Email Service)
# --------------------------------------------
RESEND_API_KEY=re_your_resend_api_key

# --------------------------------------------
# REDIS (Required - Cache)
# --------------------------------------------
REDIS_URL=redis://default:your-password@your-host:port

# --------------------------------------------
# JWT (Optional - Supabase handles JWT)
# --------------------------------------------
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# --------------------------------------------
# RATE LIMITING
# --------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# --------------------------------------------
# FILE UPLOAD
# --------------------------------------------
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,webp,pdf
